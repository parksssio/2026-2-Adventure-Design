// 2번 코드: 빛 쪽으로 서보 돌리기
// 건전지를 넣고 스위치를 켠 다음 올리세요.
// 빛 반대쪽으로 돌면 아래 DIRECTION 값을 1 -> -1 로 바꾸세요.

#include <Servo.h>

const int LEFT_PIN = A2;    // 센서 1
const int RIGHT_PIN = A3;   // 센서 2
const int SERVO_PIN = 3;    // 서보 (쉴드 3번 줄)

const int DEADBAND = 30;    // 두 센서 차이가 이보다 작으면 멈춤 (떨림 방지)
const int DIRECTION = 1;    // 반대로 돌면 -1 로 바꾸기

Servo turn;
int angle = 90;             // 가운데에서 시작

void setup() {
  Serial.begin(9600);
  turn.attach(SERVO_PIN);
  turn.write(angle);
  delay(500);               // 서보가 가운데로 갈 시간
}

void loop() {
  int left = analogRead(LEFT_PIN);
  int right = analogRead(RIGHT_PIN);
  int diff = left - right;  // +면 왼쪽이 밝음, -면 오른쪽이 밝음

  if (diff > DEADBAND) {
    angle += DIRECTION;     // 왼쪽으로 1도
  } else if (diff < -DEADBAND) {
    angle -= DIRECTION;     // 오른쪽으로 1도
  }

  angle = constrain(angle, 0, 180);  // 0~180도 밖으로 못 나가게
  turn.write(angle);

  Serial.print("왼쪽: ");
  Serial.print(left);
  Serial.print("   오른쪽: ");
  Serial.print(right);
  Serial.print("   각도: ");
  Serial.println(angle);

  delay(20);
}
