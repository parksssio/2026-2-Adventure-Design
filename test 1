// 1번 코드: 조도센서 확인용 (서보 안 움직임)
// 시리얼 모니터(9600)에 왼쪽, 오른쪽 센서 숫자를 계속 보여줘요.
// 손으로 한쪽을 가리면 그쪽 숫자가 내려가야 정상이에요.

const int LEFT_PIN = A2;   // 센서 1 (e3 선)
const int RIGHT_PIN = A3;  // 센서 2 (e8 선)

void setup() {
  Serial.begin(9600);
  Serial.println("센서 확인 시작");
}

void loop() {
  int left = analogRead(LEFT_PIN);    // 0(깜깜) ~ 1023(아주 밝음)
  int right = analogRead(RIGHT_PIN);

  Serial.print("왼쪽: ");
  Serial.print(left);
  Serial.print("   오른쪽: ");
  Serial.println(right);

  delay(200);  // 0.2초마다 한 번
}
